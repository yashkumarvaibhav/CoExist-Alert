# Webex bot credentials — enable the LIVE guard alert channel (optional).
# Create a bot at https://developer.webex.com, add it to a space, then fill these in.
# Without them the Webex channel runs in clearly-labelled simulated mode.
WEBEX_BOT_TOKEN=
WEBEX_ROOM_ID=

# Optional: enable the in-Webex "Acknowledge" button on the alert card. Set any
# strong random string; on boot the app registers an incoming webhook with Webex
# and verifies each callback's X-Spark-Signature against this secret. Absent =>
# no button, no webhook, and the /api/webex/webhook endpoint is an inert no-op.
WEBEX_WEBHOOK_SECRET=

# Public base URL used in Webex card links and as the webhook target. Keep this
# as the hosted demo URL in production (must be reachable by Webex's cloud).
COEXIST_PUBLIC_URL=https://coexist.yashkumarvaibhav.me

# Auth / RBAC. AUTH_SECRET signs the session cookies — set a long random string
# in production (a weak dev fallback is used if unset). COEXIST_ADMIN_PASSWORD
# sets the seeded admin account's password (drives the /demo controls); the
# read/respond demo accounts use the password shown on the login page.
AUTH_SECRET=
COEXIST_ADMIN_PASSWORD=

# Field simulator (all simulator data is clearly labelled SIMULATED in the UI).
# COEXIST_SIM_AUTOSTART=0 keeps the heartbeat loop off at boot (default: on).
# COEXIST_SIM_AMBIENT=1 adds occasional low-confidence signals that expire
# unconfirmed — useful for screenshots/recordings (default: off).
COEXIST_SIM_AUTOSTART=
COEXIST_SIM_AMBIENT=
