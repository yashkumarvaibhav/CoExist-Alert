# Webex bot credentials — enable the LIVE guard alert channel (optional).
# Create a bot at https://developer.webex.com, add it to a space, then fill these in.
# Without them the Webex channel runs in clearly-labelled simulated mode.
WEBEX_BOT_TOKEN=
WEBEX_ROOM_ID=

# Public base URL used in Webex card links. Keep this as the hosted demo URL in production.
COEXIST_PUBLIC_URL=https://coexist.yashkumarvaibhav.me

# Field simulator (all simulator data is clearly labelled SIMULATED in the UI).
# COEXIST_SIM_AUTOSTART=0 keeps the heartbeat loop off at boot (default: on).
# COEXIST_SIM_AMBIENT=1 adds occasional low-confidence signals that expire
# unconfirmed — useful for screenshots/recordings (default: off).
COEXIST_SIM_AUTOSTART=
COEXIST_SIM_AMBIENT=
